{
  "name": "firesong-webtest",
  "version": "0.0.0",
  "private": true,
  "description": "FireSong unit and component tests for client code. React and every client dependency come from client/node_modules; this package only adds the test runner.",
  "type": "module",
  "scripts": {
    "format": "../../client/node_modules/.bin/oxfmt -c ../../client/.oxfmtrc.json tests vitest.config.ts package.json tsconfig.json",
    "format:check": "../../client/node_modules/.bin/oxfmt -c ../../client/.oxfmtrc.json --check tests vitest.config.ts package.json tsconfig.json",
    "lint": "PATH=\"$PWD/../../client/node_modules/.bin:$PATH\" oxlint -c ../../client/.oxlintrc.json --tsconfig tsconfig.json tests vitest.config.ts",
    "test": "vitest run",
    "typecheck": "../../client/node_modules/.bin/tsc -p tsconfig.json"
  },
  "devDependencies": {
    "happy-dom": "20.14.6",
    "vite": "8.0.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.2.2"
}
