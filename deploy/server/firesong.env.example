# FireSong on the server machine: environment for the server unit and the deploy tooling.
#
# Install:  scripts/firesong/server-install.sh env      (fills the GPU UUID for you)
#      or:  install -m 600 deploy/server/firesong.env.example ~/.config/firesong/firesong.env
#           and replace every <placeholder>.
#
# The filled copy is host-specific: never commit it. Format rules, because the
# same file is a systemd EnvironmentFile, a bash `source` file and a Caddy
# --envfile: one KEY=VALUE per line, no `export`, no inline comments, no ${VAR}
# references, no spaces in values.

# --- Listeners (loopback only; Caddy and Tailscale Funnel expose them) -------
# Full router ("TV door"): Fire TV app, operator browser. Caddy proxies to it.
NIGHTINGALE_BIND=127.0.0.1:64448
# Phone router ("phone door"): the only listener Funnel publishes (WP2 adds it).
NIGHTINGALE_REMOTE_BIND=127.0.0.1:64449
# Base of every phone link (/q and /m QR codes): the Funnel origin.
NIGHTINGALE_REMOTE_URL=https://<host>.<tailnet>.ts.net:8443

# --- Data (LOCAL disk) -------------------------------------------------------
# config.json, the SQLite library (songs.db), profiles, remote-control.json and
# firesong/host-token live here. Never point this at NFS: SQLite locking is
# unsafe there. The NFS song cache comes in through config.json instead.
NIGHTINGALE_DATA_PATH=/mnt/fast/firesong/data

# --- Song cache (NFS) --------------------------------------------------------
# Mount point of the size-capped song-cache volume. Song prep refuses to run
# unless this is a mounted NFS filesystem.
FIRESONG_SONG_CACHE=/mnt/firesong-cache
# Optional: songs directory inside the mount (default <FIRESONG_SONG_CACHE>/songs).
# `party-prep.py configure` writes it to config.json cache_paths.songs.
#FIRESONG_SONG_DIR=/mnt/firesong-cache/songs
# LRU eviction keeps the cache below this many GB (10^9 bytes): about 90% of the
# volume's hard cap or the dataset's quota (36 for a 40 GB volume, 360 for 400 GB).
FIRESONG_SONG_CACHE_MAX_GB=36
# Noraebang background clips (scripts/firesong/fetch-clips.py). The server
# reads clips only from a real folder inside its media roots and outside the
# videos cache, so the pool lives in the songs directory; song prep counts it
# but never evicts it.
FIRESONG_CLIP_DIR=/mnt/firesong-cache/songs/noraebang-clips

# --- Models and analyzer vendor tree (staging SSD, not the boot disk) ----------
# Written to config.json cache_paths.models / cache_paths.vendor by `configure`.
FIRESONG_MODELS_DIR=/mnt/staging1/firesong/models
FIRESONG_VENDOR_DIR=/mnt/staging1/firesong/vendor
# The analyzer's uv would otherwise cache wheels in ~/.cache/uv on the boot disk.
UV_CACHE_DIR=/mnt/staging1/firesong/uv-cache

# --- GPU pinning --------------------------------------------------------------
# The analyzer child inherits these. Pin by UUID (`nvidia-smi -L`) to the
# RTX 4090, never to the RTX PRO 6000: the vendor step picks the torch wheel
# index from the FIRST nvidia-smi line (the 4090, cu126), and cu126 has no
# sm_120 kernels for the Blackwell card.
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=<rtx4090-gpu-uuid>
# GPU guard used by party-prep.py, and the server's GPU gate before every
# analysis job: hold while ~/.config/gpu-reservations/<CUDA_VISIBLE_DEVICES>
# is in force (or starts within 10 minutes) or the GPU has less than this many
# GiB free (FireSong's own analyzer does not count).
FIRESONG_GPU_MIN_FREE_GB=6
# Optional, for the server's gate: the GPU to check when CUDA_VISIBLE_DEVICES
# is not a single UUID, and another reservations folder.
#FIRESONG_GPU_UUID=<rtx4090-gpu-uuid>
#FIRESONG_GPU_RESERVATIONS_DIR=/home/<user>/.config/gpu-reservations
# Stop the idle analyzer server (and free its GPU memory) this many seconds
# after the queue drains; the next job starts it again (WP1b).
NIGHTINGALE_ANALYZER_IDLE_EXIT_SECS=300

# --- TV door (Caddy, deploy/server/Caddyfile.tv) -------------------------------
# the server machine's LAN address: Caddy listens on <FIRESONG_LAN_IP>:<FIRESONG_TV_PORT>.
FIRESONG_LAN_IP=<server-lan-ip>
FIRESONG_TV_PORT=64443
# The Fire TV Cube: allowed by Caddy, the adb target for cube.sh, and the TV the party door watches
# (with the serial set, the party door also keeps the Cube's log during parties; docs/firesong/FLIGHT.md).
FIRESONG_CUBE_IP=<cube-lan-ip>
FIRESONG_CUBE_SERIAL=<cube-lan-ip>:5555
# Optional: the URL flags FireSong on the Cube keeps outside test runs, as &name=value pairs (none when
# unset). party-gate.py, party-rig.py and cube-load-test.py set the TV's URL for a run and put it back
# with these flags (or with their --restore-flags), e.g. once the TV app plays the voices itself:
#FIRESONG_TV_URL_FLAGS=&voice=native
# Caddy state (its internal CA root, which the Fire TV app pins).
FIRESONG_CADDY_STORAGE=/mnt/fast/firesong/caddy

# --- Owner one-time steps (read by `server-install.sh owner-steps`) ------------
# NFS server that exports the song-cache volume.
FIRESONG_NFS_SERVER=<nfs-server-lan-ip>
FIRESONG_NFS_EXPORT=/var/lib/firesong-cache

# --- Optional -----------------------------------------------------------------
RUST_LOG=info,tower_http=info,server=info
# Minutes the party door stays open after FireSong leaves the TV (party-door.sh).
#FIRESONG_DOOR_IDLE_MIN=20
# Minutes party mode outlasts the TV: while FireSong is on the TV and this long after, the
# analyzer prepares only songs guests asked for, and party-prep.py waits (no library rescan).
#FIRESONG_PARTY_HOLD_MIN=20
# Noraebang band trial: songs with a rendered band track (<cache>/<hash>_band_campy.mp3 or
# _band_blend.mp3) play it in place of their instrumental at their own key and tempo.
#FIRESONG_BAND=campy
# Runtime-only Pixabay key for background videos (never a build argument).
#PIXABAY_API_KEY=
# NIGHTINGALE_LIBRARY_PATH must stay UNSET: it re-pins a folder over Plex on
# every start.
